# Copy this file to .env (next to main.py, or next to JARVIS_gui.exe) and fill in your keys.

# AI provider: groq (free, default) or perplexity
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key
PERPLEXITY_API_KEY=your_perplexity_api_key
# Optional: override the provider's default model
# AI_MODEL=openai/gpt-oss-20b
# Optional: let Groq search the web for current events (on/off, default on)
# AI_WEB_SEARCH=on

NEWS_API_KEY=your_newsapi_key
# Optional: two-letter country code for top headlines (default: us)
NEWS_COUNTRY=us
